    "searchUrl": "https://www.deqixs.com/search.html,{\"method\":\"POST\",\"body\":\"searchtype=all&searchkey={{key}}\",\"charset\":\"utf-8\"}",
    "jsLib": "function cover(url) { return url ? 'https://www.deqixs.com' + url : ''; }\nfunction words(str) { var m = str.match(/\\d+/); return m ? m[0] : str; }",
    "ruleSearch": {
      "bookList": "class.bookcase@li",
      "name": "class.bookname@a@text",
      "author": "class.author@text",
      "lastChapter": "class.updata@a@text",
      "coverUrl": "class.bookcover@img@src",
      "bookUrl": "class.bookname@a@href"
    },
    "ruleBookInfo": {
      "name": "class.bookname@text",
      "author": "class.author@a@text",
      "lastChapter": "class.chapter@a@text",
      "coverUrl": "class.bookcover@img@src##src=(.*?)##$1",
      "wordCount": "id.status@span@text##字数：||@js:words(result)",
      "intro": "class.intro@text"
    },
    "ruleToc": {
      "chapterList": "id.list-chapterAll@dd@a",
      "chapterName": "@text",
      "chapterUrl": "@href",
      "isVolume": ""
    },
    "ruleContent": {
      "content": "id.txt@html##<script[^>]*>[\\s\\S]*?</script>||@js:result",
      "replaceRegex": []
    }
  },
